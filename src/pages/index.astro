---
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f3ee" />
    <meta
      name="description"
      content="Generate a complete favicon package from your logo, directly in your browser."
    />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <title>Favicon Forge — Generate favicons from your logo</title>
  </head>
  <body>
    <main class="page-shell">
      <header class="topbar">
        <a class="brand" href="./" aria-label="Favicon Forge">
          <span class="brand-mark" aria-hidden="true">F</span>
          <span>Favicon Forge</span>
        </a>
        <span class="privacy-pill"><span class="privacy-dot"></span> Runs locally</span>
      </header>

      <section class="hero" aria-labelledby="page-title">
        <div class="eyebrow">Logo → favicon package</div>
        <h1 id="page-title">One logo.<br /><em>Every favicon.</em></h1>
        <p class="hero-copy">
          Drop your logo here. Favicon Forge creates every file you need for your website,
          iPhone, Android and PWA — without uploading your image.
        </p>
      </section>

      <section class="forge-card" aria-labelledby="forge-title">
        <div class="section-heading">
          <div>
            <div class="step-label">01 <span>/</span> UPLOAD</div>
            <h2 id="forge-title">Choose your logo</h2>
          </div>
          <span class="format-note">PNG · JPG · WEBP · SVG</span>
        </div>

        <div class="drop-zone" id="drop-zone" role="button" tabindex="0" aria-label="Choose or drop a logo">
          <input id="file-input" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden />
          <div class="drop-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path d="M16 22V5m0 0-6 6m6-6 6 6M7 19v6h18v-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="drop-title">Drop your logo here</div>
          <div class="drop-subtitle">or <span>choose a file</span> from your computer</div>
          <div class="drop-limit">Up to 10 MB · square or transparent logos work best</div>
        </div>

        <p class="error-message" id="error-message" role="alert" hidden></p>

        <div class="result-panel" id="result-panel" hidden>
          <div class="result-header">
            <div>
              <div class="step-label">02 <span>/</span> PREVIEW</div>
              <h2>Your favicon package is ready</h2>
            </div>
            <button class="text-button" id="change-button" type="button">Choose another</button>
          </div>

          <div class="preview-layout">
            <div class="source-preview">
              <div class="preview-label">SOURCE LOGO</div>
              <div class="source-frame checkerboard">
                <img id="source-preview" alt="Selected logo" />
              </div>
              <div class="file-meta" id="file-meta"></div>
            </div>

            <div class="generated-previews">
              <div class="preview-label">OUTPUT SIZES</div>
              <div class="preview-grid" id="preview-grid"></div>
            </div>
          </div>

          <div class="package-settings">
            <label for="site-name">Website name <span>(used in the manifest)</span></label>
            <input id="site-name" type="text" maxlength="60" autocomplete="off" />
          </div>

          <div class="render-settings">
            <label class="pixel-option" for="pixel-mode">
              <input id="pixel-mode" type="checkbox" />
              <span class="pixel-switch" aria-hidden="true"></span>
              <span class="pixel-copy">
                <strong>Pixel art mode</strong>
                <small id="render-mode-note">Nearest-neighbor scaling for hard edges</small>
              </span>
            </label>
          </div>

          <div class="focus-settings" id="focus-settings" hidden>
            <div class="focus-copy">
              <strong>Favicon focus</strong>
              <small id="focus-note">This logo contains four separate marks. A single mark stays sharper at 16×16.</small>
            </div>
            <select id="focus-select" aria-label="Choose the favicon focus">
              <option value="full">Full logo</option>
              <option value="0">Top-left mark</option>
              <option value="1">Top-right mark</option>
              <option value="2">Bottom-left mark</option>
              <option value="3">Bottom-right mark</option>
            </select>
          </div>

          <div class="download-row">
            <div class="package-summary">
              <span class="ready-icon">✓</span>
              <span><strong>10 files</strong> · ICO, PNG, manifest &amp; setup guide</span>
            </div>
            <button class="download-button" id="download-button" type="button">
              Download package <span aria-hidden="true">↓</span>
            </button>
          </div>
          <div class="download-hint" id="download-hint">Unzip the package and copy the files into your Astro <code>public/</code> folder.</div>
        </div>
      </section>

      <section class="how-it-works" aria-labelledby="how-title">
        <div class="section-heading compact">
          <div>
            <div class="step-label">03 <span>/</span> READY TO USE</div>
            <h2 id="how-title">Where to use it</h2>
          </div>
        </div>
        <div class="use-grid">
          <div class="use-item">
            <span class="use-number">01</span>
            <div><strong>Astro</strong><p>Copy the ZIP into <code>public/</code>, then add the HTML snippet to your layout.</p></div>
          </div>
          <div class="use-item">
            <span class="use-number">02</span>
            <div><strong>GitHub Pages</strong><p>Relative paths work with both project sites and custom domains.</p></div>
          </div>
          <div class="use-item">
            <span class="use-number">03</span>
            <div><strong>No upload</strong><p>Your image is read and processed only in this browser tab.</p></div>
          </div>
        </div>
      </section>

      <footer class="footer">
        <span>Favicon Forge</span>
        <span>Built for the small details.</span>
      </footer>
    </main>

    <script>
      // @ts-nocheck — this small client-only module works directly with DOM and Canvas APIs.
      import JSZip from 'jszip';

      const MAX_FILE_SIZE = 10 * 1024 * 1024;
      const OUTPUT_SIZES = [16, 32, 48, 180, 192, 512];
      const PREVIEW_SIZES = [16, 32, 48, 180, 192, 512];
      const PREVIEW_DISPLAY_SIZES = {
        16: 32,
        32: 40,
        48: 48,
        180: 100,
        192: 108,
        512: 124,
      };
      const $ = (selector) => document.querySelector(selector);

      const dropZone = $('#drop-zone');
      const fileInput = $('#file-input');
      const errorMessage = $('#error-message');
      const resultPanel = $('#result-panel');
      const sourcePreview = $('#source-preview');
      const fileMeta = $('#file-meta');
      const previewGrid = $('#preview-grid');
      const siteNameInput = $('#site-name');
      const pixelModeInput = $('#pixel-mode');
      const renderModeNote = $('#render-mode-note');
      const focusSettings = $('#focus-settings');
      const focusSelect = $('#focus-select');
      const focusNote = $('#focus-note');
      const downloadButton = $('#download-button');
      const downloadHint = $('#download-hint');
      const changeButton = $('#change-button');

      let selectedFile = null;
      let loadedImage = null;
      let sourceCanvas = null;
      let sourceRegions = [];
      let previewObjectUrl = null;
      let pixelMode = false;
      let focusSelection = 'full';

      function showError(message) {
        errorMessage.textContent = message;
        errorMessage.hidden = false;
      }

      function clearError() {
        errorMessage.hidden = true;
        errorMessage.textContent = '';
      }

      function formatBytes(bytes) {
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
        return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
      }

      function fileNameToSiteName(fileName) {
        const withoutExtension = fileName.replace(/\.[^/.]+$/, '');
        const readable = withoutExtension.replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
        return readable || 'My Website';
      }

      function loadImage(file) {
        return new Promise((resolve, reject) => {
          const objectUrl = URL.createObjectURL(file);
          const image = new Image();
          image.onload = () => {
            URL.revokeObjectURL(objectUrl);
            resolve(image);
          };
          image.onerror = () => {
            URL.revokeObjectURL(objectUrl);
            reject(new Error('This image could not be read. Try another PNG, JPG, WEBP or SVG file.'));
          };
          image.src = objectUrl;
        });
      }

      function detectPixelArt(file, image) {
        // Small, compact raster assets are commonly pixel art or intentionally hard-edged.
        // Prefer nearest-neighbor for them; regular high-resolution logos keep smoothing.
        return Math.max(image.naturalWidth, image.naturalHeight) <= 512
          && file.size <= 300 * 1024;
      }

      function updatePixelMode(enabled, rerender = true) {
        pixelMode = enabled;
        pixelModeInput.checked = enabled;
        previewGrid.classList.toggle('pixel-mode', enabled);
        sourcePreview.classList.toggle('pixelated', enabled);
        renderModeNote.textContent = enabled
          ? 'Pixel edges preserved with nearest-neighbor scaling'
          : 'High-quality smoothing for regular logos';
        if (rerender && loadedImage) renderPreviews();
      }

      function createTrimmedSource(image) {
        const width = image.naturalWidth;
        const height = image.naturalHeight;
        const fullCanvas = document.createElement('canvas');
        fullCanvas.width = width;
        fullCanvas.height = height;
        const fullContext = fullCanvas.getContext('2d');
        fullContext.drawImage(image, 0, 0, width, height);

        const pixels = fullContext.getImageData(0, 0, width, height).data;
        let minX = width;
        let minY = height;
        let maxX = -1;
        let maxY = -1;

        for (let y = 0; y < height; y += 1) {
          for (let x = 0; x < width; x += 1) {
            const alpha = pixels[(y * width + x) * 4 + 3];
            if (alpha > 8) {
              minX = Math.min(minX, x);
              minY = Math.min(minY, y);
              maxX = Math.max(maxX, x);
              maxY = Math.max(maxY, y);
            }
          }
        }

        if (maxX < 0) return fullCanvas;

        const trimmedCanvas = document.createElement('canvas');
        trimmedCanvas.width = maxX - minX + 1;
        trimmedCanvas.height = maxY - minY + 1;
        // Copy pixels directly so trimming never introduces a second resampling pass.
        trimmedCanvas.getContext('2d').putImageData(
          fullContext.getImageData(minX, minY, trimmedCanvas.width, trimmedCanvas.height),
          0,
          0,
        );
        return trimmedCanvas;
      }

      function getOccupiedGroups(canvas, axis) {
        const context = canvas.getContext('2d');
        const pixels = context.getImageData(0, 0, canvas.width, canvas.height).data;
        const length = axis === 'row' ? canvas.height : canvas.width;
        const groups = [];
        let start = -1;

        for (let index = 0; index < length; index += 1) {
          let occupied = false;
          const from = axis === 'row' ? 0 : index;
          const to = axis === 'row' ? canvas.width : canvas.height;
          for (let offset = from; offset < to; offset += 1) {
            const x = axis === 'row' ? offset : index;
            const y = axis === 'row' ? index : offset;
            if (pixels[(y * canvas.width + x) * 4 + 3] > 8) {
              occupied = true;
              break;
            }
          }

          if (occupied && start < 0) start = index;
          if (!occupied && start >= 0) {
            groups.push({ start, end: index - 1 });
            start = -1;
          }
        }

        if (start >= 0) groups.push({ start, end: length - 1 });
        return groups;
      }

      function detectFocusRegions(canvas) {
        if (!canvas) return [];
        const rows = getOccupiedGroups(canvas, 'row');
        const columns = getOccupiedGroups(canvas, 'column');
        if (rows.length !== 2 || columns.length !== 2) return [];

        const regions = [];
        rows.forEach((row) => {
          columns.forEach((column) => {
            regions.push({
              x: column.start,
              y: row.start,
              width: column.end - column.start + 1,
              height: row.end - row.start + 1,
            });
          });
        });
        return regions;
      }

      function getActiveSource() {
        const source = sourceCanvas || loadedImage;
        const fullWidth = sourceCanvas ? sourceCanvas.width : loadedImage.naturalWidth;
        const fullHeight = sourceCanvas ? sourceCanvas.height : loadedImage.naturalHeight;
        const region = focusSelection === 'full' ? null : sourceRegions[Number(focusSelection)];
        return region
          ? { source, x: region.x, y: region.y, width: region.width, height: region.height }
          : { source, x: 0, y: 0, width: fullWidth, height: fullHeight };
      }

      function createIconCanvas(size) {
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const context = canvas.getContext('2d');
        context.clearRect(0, 0, size, size);
        context.imageSmoothingEnabled = !pixelMode;
        if (!pixelMode) context.imageSmoothingQuality = 'high';

        const activeSource = getActiveSource();
        const source = activeSource.source;
        const sourceWidth = activeSource.width;
        const sourceHeight = activeSource.height;
        // The transparent margins have already been cropped. Pixel art should use
        // every available pixel instead of adding another shrinking pass.
        const padding = pixelMode ? 0 : size < 64 ? 0.14 : 0.1;
        const available = size * (1 - padding * 2);
        const scale = Math.min(available / sourceWidth, available / sourceHeight);
        let width = sourceWidth * scale;
        let height = sourceHeight * scale;
        let x = (size - width) / 2;
        let y = (size - height) / 2;

        if (pixelMode) {
          width = Math.max(1, Math.round(width));
          height = Math.max(1, Math.round(height));
          x = Math.floor((size - width) / 2);
          y = Math.floor((size - height) / 2);
        }

        context.drawImage(
          source,
          activeSource.x,
          activeSource.y,
          sourceWidth,
          sourceHeight,
          x,
          y,
          width,
          height,
        );
        return canvas;
      }

      function canvasToBlob(canvas) {
        return new Promise((resolve, reject) => {
          canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('Could not create a PNG.')), 'image/png');
        });
      }

      function createIco(entries) {
        const headerSize = 6;
        const directoryEntrySize = 16;
        const dataOffset = headerSize + directoryEntrySize * entries.length;
        const totalSize = dataOffset + entries.reduce((sum, entry) => sum + entry.bytes.length, 0);
        const buffer = new ArrayBuffer(totalSize);
        const view = new DataView(buffer);
        const bytes = new Uint8Array(buffer);

        view.setUint16(0, 0, true);
        view.setUint16(2, 1, true);
        view.setUint16(4, entries.length, true);

        let offset = dataOffset;
        entries.forEach((entry, index) => {
          const directoryOffset = headerSize + index * directoryEntrySize;
          view.setUint8(directoryOffset, entry.size === 256 ? 0 : entry.size);
          view.setUint8(directoryOffset + 1, entry.size === 256 ? 0 : entry.size);
          view.setUint8(directoryOffset + 2, 0);
          view.setUint8(directoryOffset + 3, 0);
          view.setUint16(directoryOffset + 4, 1, true);
          view.setUint16(directoryOffset + 6, 32, true);
          view.setUint32(directoryOffset + 8, entry.bytes.length, true);
          view.setUint32(directoryOffset + 12, offset, true);
          bytes.set(entry.bytes, offset);
          offset += entry.bytes.length;
        });

        return new Blob([buffer], { type: 'image/x-icon' });
      }

      function renderPreviews() {
        previewGrid.replaceChildren();
        PREVIEW_SIZES.forEach((size) => {
          const card = document.createElement('div');
          card.className = 'preview-card';
          const label = document.createElement('span');
          label.textContent = `${size}×${size}`;
          const frame = document.createElement('div');
          frame.className = `icon-frame checkerboard size-${size}`;
          // Render the preview directly at its display size. Rendering a 180/192/512
          // canvas first and then shrinking it with CSS makes the browser filter
          // pixel-art a second time, which looks soft even when the downloaded PNG is sharp.
          const displaySize = PREVIEW_DISPLAY_SIZES[size];
          const canvas = createIconCanvas(displaySize);
          canvas.setAttribute('aria-label', `Preview favicon ${size}x${size}, enlarged for display`);
          frame.append(canvas);
          card.append(frame, label);
          previewGrid.append(card);
        });
      }

      async function handleFile(file) {
        clearError();
        if (!file) return;
        if (!file.type.startsWith('image/')) {
          showError('Please choose an image file.');
          return;
        }
        if (file.size > MAX_FILE_SIZE) {
          showError('That file is too large. Please choose an image smaller than 10 MB.');
          return;
        }

        try {
          selectedFile = file;
          loadedImage = await loadImage(file);
          sourceCanvas = createTrimmedSource(loadedImage);
          sourceRegions = detectFocusRegions(sourceCanvas);
          focusSelection = 'full';
          focusSelect.value = focusSelection;
          focusSettings.hidden = sourceRegions.length !== 4;
          focusNote.textContent = sourceRegions.length === 4
            ? 'Four separate marks detected. A single mark stays sharper at 16×16.'
            : 'Use the full logo, or choose pixel art mode to preserve hard edges.';
          updatePixelMode(detectPixelArt(file, loadedImage), false);
          if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
          previewObjectUrl = URL.createObjectURL(file);
          sourcePreview.src = previewObjectUrl;
          sourcePreview.alt = `Logo ${file.name}`;
          const trimmed = sourceCanvas.width !== loadedImage.naturalWidth || sourceCanvas.height !== loadedImage.naturalHeight;
          fileMeta.textContent = `${file.name} · ${loadedImage.naturalWidth}×${loadedImage.naturalHeight} · ${formatBytes(file.size)}${trimmed ? ' · transparent margins cropped' : ''}`;
          siteNameInput.value = fileNameToSiteName(file.name);
          renderPreviews();
          resultPanel.hidden = false;
          dropZone.classList.add('has-result');
          downloadHint.textContent = 'Unzip the package and copy the files into your Astro public/ folder.';
          resultPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (error) {
          selectedFile = null;
          loadedImage = null;
          sourceCanvas = null;
          sourceRegions = [];
          showError(error.message);
        }
      }

      function makeSnippet() {
        return `<!-- Favicon Forge: copy this into your <head> -->
<link rel="icon" href="./favicon-32x32.png" type="image/png" sizes="32x32">
<link rel="icon" href="./favicon-16x16.png" type="image/png" sizes="16x16">
<link rel="icon" href="./favicon.ico" type="image/x-icon">
<link rel="apple-touch-icon" sizes="180x180" href="./apple-touch-icon.png">
<link rel="manifest" href="./site.webmanifest">
<meta name="theme-color" content="#ffffff">`;
      }

      function makeManifest(siteName) {
        return JSON.stringify({
          name: siteName,
          short_name: siteName.slice(0, 20),
          start_url: './',
          scope: './',
          display: 'standalone',
          theme_color: '#ffffff',
          background_color: '#ffffff',
          icons: [
            { src: './android-chrome-192x192.png', sizes: '192x192', type: 'image/png', purpose: 'any' },
            { src: './android-chrome-512x512.png', sizes: '512x512', type: 'image/png', purpose: 'any' },
            { src: './android-chrome-512x512-maskable.png', sizes: '512x512', type: 'image/png', purpose: 'maskable' }
          ]
        }, null, 2);
      }

      function makeReadme() {
        return `FAVICON FORGE\n\nAstro / GitHub Pages\n\n1. Copy these files into your site's public/ folder (or next to index.html).\n2. Copy the contents of favicon-snippet.html into your page <head>.\n3. Build and deploy. The links use relative paths, so they work on GitHub Pages project sites.\n\nGenerated locally in your browser. The source logo was not uploaded.\n`;
      }

      async function buildZip() {
        const sizes = new Map();
        for (const size of OUTPUT_SIZES) {
          sizes.set(size, await canvasToBlob(createIconCanvas(size)));
        }

        const icoEntries = [];
        for (const size of [16, 32, 48]) {
          icoEntries.push({ size, bytes: new Uint8Array(await sizes.get(size).arrayBuffer()) });
        }

        const siteName = siteNameInput.value.trim() || 'My Website';
        const zip = new JSZip();
        zip.file('favicon.ico', createIco(icoEntries));
        zip.file('favicon-16x16.png', sizes.get(16));
        zip.file('favicon-32x32.png', sizes.get(32));
        zip.file('apple-touch-icon.png', sizes.get(180));
        zip.file('android-chrome-192x192.png', sizes.get(192));
        zip.file('android-chrome-512x512.png', sizes.get(512));
        zip.file('android-chrome-512x512-maskable.png', sizes.get(512));
        zip.file('site.webmanifest', makeManifest(siteName));
        zip.file('favicon-snippet.html', makeSnippet());
        zip.file('README.txt', makeReadme());
        return zip.generateAsync({ type: 'blob', compression: 'DEFLATE', compressionOptions: { level: 6 } });
      }

      async function downloadPackage() {
        if (!selectedFile || !loadedImage) return;
        downloadButton.disabled = true;
        downloadButton.classList.add('is-loading');
        downloadButton.innerHTML = 'Packaging <span class="spinner" aria-hidden="true"></span>';
        try {
          const zipBlob = await buildZip();
          const url = URL.createObjectURL(zipBlob);
          const anchor = document.createElement('a');
          anchor.href = url;
          anchor.download = 'favicon-package.zip';
          document.body.append(anchor);
          anchor.click();
          anchor.remove();
          URL.revokeObjectURL(url);
          downloadHint.textContent = 'Downloaded. Open favicon-snippet.html to copy the tags into your <head>.';
        } catch (error) {
          showError(`Could not create the ZIP file: ${error.message}`);
        } finally {
          downloadButton.disabled = false;
          downloadButton.classList.remove('is-loading');
          downloadButton.innerHTML = 'Download package <span aria-hidden="true">↓</span>';
        }
      }

      dropZone.addEventListener('click', () => fileInput.click());
      dropZone.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          fileInput.click();
        }
      });
      fileInput.addEventListener('change', (event) => handleFile(event.target.files?.[0]));
      changeButton.addEventListener('click', () => fileInput.click());
      downloadButton.addEventListener('click', downloadPackage);
      pixelModeInput.addEventListener('change', () => updatePixelMode(pixelModeInput.checked));
      focusSelect.addEventListener('change', () => {
        focusSelection = focusSelect.value;
        renderPreviews();
      });

      ['dragenter', 'dragover'].forEach((eventName) => {
        dropZone.addEventListener(eventName, (event) => {
          event.preventDefault();
          dropZone.classList.add('is-dragging');
        });
      });
      ['dragleave', 'drop'].forEach((eventName) => {
        dropZone.addEventListener(eventName, (event) => {
          event.preventDefault();
          dropZone.classList.remove('is-dragging');
        });
      });
      dropZone.addEventListener('drop', (event) => handleFile(event.dataTransfer.files?.[0]));
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #f4f3ee; scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    color: #121416;
    background: #f4f3ee;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(button), :global(input) { font: inherit; }
  :global(button) { cursor: pointer; }
  :global(code) { font-family: "SFMono-Regular", Consolas, monospace; font-size: .88em; }
  .page-shell { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
  .topbar { height: 84px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #d9d8d1; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: #121416; font-size: 14px; font-weight: 750; letter-spacing: -.02em; text-decoration: none; }
  .brand-mark { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 9px; background: #121416; color: #d9ff57; font-size: 14px; font-weight: 800; }
  .privacy-pill { display: inline-flex; align-items: center; gap: 8px; color: #676861; font-size: 12px; }
