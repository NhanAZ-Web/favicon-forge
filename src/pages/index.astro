---
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f3ee" />
    <meta
      name="description"
      content="Generate a complete favicon package from your logo, directly in your browser."
    />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <title>Favicon Forge — Generate favicons from your logo</title>
  </head>
  <body>
    <main class="page-shell">
      <header class="topbar">
        <a class="brand" href="./" aria-label="Favicon Forge">
          <span class="brand-mark" aria-hidden="true">F</span>
          <span>Favicon Forge</span>
        </a>
        <span class="privacy-pill"><span class="privacy-dot"></span> Private · runs locally</span>
      </header>

      <section class="intro" aria-labelledby="page-title">
        <h1 id="page-title">Generate favicons</h1>
        <p>Drop one logo. Download the complete package.</p>
      </section>

      <section class="workspace" aria-label="Favicon generator">
        <div class="drop-zone" id="drop-zone" role="button" tabindex="0" aria-label="Choose or drop a logo">
          <input id="file-input" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden />
          <div class="drop-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path d="M16 22V5m0 0-6 6m6-6 6 6M7 19v6h18v-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <div class="drop-title">Drop or choose a logo</div>
            <div class="drop-subtitle">PNG, JPG, WEBP or SVG · 512×512 or larger recommended</div>
          </div>
        </div>

        <p class="error-message" id="error-message" role="alert" hidden></p>

        <div class="result-panel" id="result-panel" hidden>
          <div class="result-header">
            <h2>Preview</h2>
            <button class="text-button" id="change-button" type="button">Choose another</button>
          </div>

          <div class="preview-layout">
            <div class="source-preview">
              <div class="preview-label">SOURCE LOGO</div>
              <div class="source-frame checkerboard">
                <img class="pixelated" id="source-preview" alt="Selected logo" />
              </div>
              <div class="file-meta" id="file-meta"></div>
            </div>

            <div class="generated-previews">
              <div class="preview-label">OUTPUT SIZES</div>
              <div class="preview-grid pixel-mode" id="preview-grid"></div>
              <p class="quality-note" id="quality-note" hidden></p>
            </div>
          </div>

          <details class="options">
            <summary>Options</summary>
            <div class="options-grid">
              <div class="package-settings">
                <label for="site-name">Website name</label>
                <input id="site-name" type="text" maxlength="60" autocomplete="off" />
              </div>
            </div>
          </details>

          <button class="download-button" id="download-button" type="button">
            Download favicon package <span aria-hidden="true">↓</span>
          </button>
          <p class="download-hint" id="download-hint">10 files · ICO, PNG, manifest and setup guide</p>
        </div>
      </section>
    </main>

    <script>
      // @ts-nocheck — this small client-only module works directly with DOM and Canvas APIs.
      import JSZip from 'jszip';

      const MAX_FILE_SIZE = 10 * 1024 * 1024;
      const OUTPUT_SIZES = [16, 32, 48, 180, 192, 512];
      const PREVIEW_SIZES = [16, 32, 48, 180, 192, 512];
      const PREVIEW_DISPLAY_SIZES = {
        16: 16,
        32: 32,
        48: 48,
        180: 180,
        192: 192,
        512: 256,
      };
      const $ = (selector) => document.querySelector(selector);

      const dropZone = $('#drop-zone');
      const fileInput = $('#file-input');
      const errorMessage = $('#error-message');
      const resultPanel = $('#result-panel');
      const sourcePreview = $('#source-preview');
      const fileMeta = $('#file-meta');
      const previewGrid = $('#preview-grid');
      const qualityNote = $('#quality-note');
      const siteNameInput = $('#site-name');
      const downloadButton = $('#download-button');
      const downloadHint = $('#download-hint');
      const changeButton = $('#change-button');

      let selectedFile = null;
      let loadedImage = null;
      let previewObjectUrl = null;

      function showError(message) {
        errorMessage.textContent = message;
        errorMessage.hidden = false;
      }

      function clearError() {
        errorMessage.hidden = true;
        errorMessage.textContent = '';
      }

      function formatBytes(bytes) {
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
        return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
      }

      function fileNameToSiteName(fileName) {
        const withoutExtension = fileName.replace(/\.[^/.]+$/, '');
        const readable = withoutExtension.replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
        return readable || 'My Website';
      }

      function loadImage(file) {
        return new Promise((resolve, reject) => {
          const objectUrl = URL.createObjectURL(file);
          const image = new Image();
          image.onload = () => {
            URL.revokeObjectURL(objectUrl);
            resolve(image);
          };
          image.onerror = () => {
            URL.revokeObjectURL(objectUrl);
            reject(new Error('This image could not be read. Try another PNG, JPG, WEBP or SVG file.'));
          };
          image.src = objectUrl;
        });
      }

      function createIconCanvas(size) {
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const context = canvas.getContext('2d');
        context.clearRect(0, 0, size, size);
        context.imageSmoothingEnabled = false;

        // Preserve the complete source canvas, including intentional transparent
        // margins. Cropping it changes the pixel grid and makes pixel art uneven.
        const source = loadedImage;
        const sourceWidth = loadedImage.naturalWidth;
        const sourceHeight = loadedImage.naturalHeight;
        const scale = Math.min(size / sourceWidth, size / sourceHeight);
        let width = sourceWidth * scale;
        let height = sourceHeight * scale;
        let x = (size - width) / 2;
        let y = (size - height) / 2;

        width = Math.max(1, Math.round(width));
        height = Math.max(1, Math.round(height));
        x = Math.floor((size - width) / 2);
        y = Math.floor((size - height) / 2);

        context.drawImage(
          source,
          0,
          0,
          sourceWidth,
          sourceHeight,
          x,
          y,
          width,
          height,
        );
        return canvas;
      }

      function canvasToBlob(canvas) {
        return new Promise((resolve, reject) => {
          canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('Could not create a PNG.')), 'image/png');
        });
      }

      function createPreviewCanvas(size) {
        const outputCanvas = createIconCanvas(size);
        const displaySize = PREVIEW_DISPLAY_SIZES[size];
        const pixelRatio = Math.max(1, window.devicePixelRatio || 1);
        const backingSize = Math.round(displaySize * pixelRatio);
        const previewCanvas = document.createElement('canvas');
        previewCanvas.width = backingSize;
        previewCanvas.height = backingSize;
        previewCanvas.style.width = `${displaySize}px`;
        previewCanvas.style.height = `${displaySize}px`;
        const context = previewCanvas.getContext('2d');
        context.imageSmoothingEnabled = false;
        context.drawImage(outputCanvas, 0, 0, backingSize, backingSize);
        return previewCanvas;
      }

      function createIco(entries) {
        const headerSize = 6;
        const directoryEntrySize = 16;
        const dataOffset = headerSize + directoryEntrySize * entries.length;
        const totalSize = dataOffset + entries.reduce((sum, entry) => sum + entry.bytes.length, 0);
        const buffer = new ArrayBuffer(totalSize);
        const view = new DataView(buffer);
        const bytes = new Uint8Array(buffer);

        view.setUint16(0, 0, true);
        view.setUint16(2, 1, true);
        view.setUint16(4, entries.length, true);

        let offset = dataOffset;
        entries.forEach((entry, index) => {
          const directoryOffset = headerSize + index * directoryEntrySize;
          view.setUint8(directoryOffset, entry.size === 256 ? 0 : entry.size);
          view.setUint8(directoryOffset + 1, entry.size === 256 ? 0 : entry.size);
          view.setUint8(directoryOffset + 2, 0);
          view.setUint8(directoryOffset + 3, 0);
          view.setUint16(directoryOffset + 4, 1, true);
          view.setUint16(directoryOffset + 6, 32, true);
          view.setUint32(directoryOffset + 8, entry.bytes.length, true);
          view.setUint32(directoryOffset + 12, offset, true);
          bytes.set(entry.bytes, offset);
          offset += entry.bytes.length;
        });

        return new Blob([buffer], { type: 'image/x-icon' });
      }

      function renderPreviews() {
        previewGrid.replaceChildren();
        PREVIEW_SIZES.forEach((size) => {
          const card = document.createElement('div');
          card.className = 'preview-card';
          const label = document.createElement('span');
          label.textContent = `${size}×${size}`;
          const frame = document.createElement('div');
          frame.className = `icon-frame checkerboard size-${size}`;
          // Build the real output first, then make a separate preview canvas.
          // Its bitmap and CSS dimensions match, so the browser never rescales it.
          const canvas = createPreviewCanvas(size);
          canvas.setAttribute('aria-label', `Preview favicon ${size}x${size}`);
          frame.append(canvas);
          card.append(frame, label);
          previewGrid.append(card);
        });
      }

      async function handleFile(file) {
        clearError();
        if (!file) return;
        if (!file.type.startsWith('image/')) {
          showError('Please choose an image file.');
          return;
        }
        if (file.size > MAX_FILE_SIZE) {
          showError('That file is too large. Please choose an image smaller than 10 MB.');
          return;
        }

        try {
          selectedFile = file;
          loadedImage = await loadImage(file);
          if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
          previewObjectUrl = URL.createObjectURL(file);
          sourcePreview.src = previewObjectUrl;
          sourcePreview.alt = `Logo ${file.name}`;
          fileMeta.textContent = `${file.name} · ${loadedImage.naturalWidth}×${loadedImage.naturalHeight} · ${formatBytes(file.size)}`;
          const largestSide = Math.max(loadedImage.naturalWidth, loadedImage.naturalHeight);
          qualityNote.hidden = largestSide >= 512;
          qualityNote.textContent = largestSide < 512
            ? `Source is ${loadedImage.naturalWidth}×${loadedImage.naturalHeight}. The 512×512 file is enlarged and cannot contain more detail than the source.`
            : '';
          siteNameInput.value = fileNameToSiteName(file.name);
          renderPreviews();
          resultPanel.hidden = false;
          dropZone.hidden = true;
          downloadHint.textContent = '10 files · ICO, PNG, manifest and setup guide';
          resultPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (error) {
          selectedFile = null;
          loadedImage = null;
          showError(error.message);
        }
      }

      function makeSnippet() {
        return `<!-- Favicon Forge: copy this into your <head> -->
<link rel="icon" href="./favicon-32x32.png" type="image/png" sizes="32x32">
<link rel="icon" href="./favicon-16x16.png" type="image/png" sizes="16x16">
<link rel="icon" href="./favicon.ico" type="image/x-icon">
<link rel="apple-touch-icon" sizes="180x180" href="./apple-touch-icon.png">
<link rel="manifest" href="./site.webmanifest">
<meta name="theme-color" content="#ffffff">`;
      }

      function makeManifest(siteName) {
        return JSON.stringify({
          name: siteName,
          short_name: siteName.slice(0, 20),
          start_url: './',
          scope: './',
          display: 'standalone',
          theme_color: '#ffffff',
          background_color: '#ffffff',
          icons: [
            { src: './android-chrome-192x192.png', sizes: '192x192', type: 'image/png', purpose: 'any' },
            { src: './android-chrome-512x512.png', sizes: '512x512', type: 'image/png', purpose: 'any' },
            { src: './android-chrome-512x512-maskable.png', sizes: '512x512', type: 'image/png', purpose: 'maskable' }
          ]
        }, null, 2);
      }

      function makeReadme() {
        return `FAVICON FORGE\n\nAstro / GitHub Pages\n\n1. Copy these files into your site's public/ folder (or next to index.html).\n2. Copy the contents of favicon-snippet.html into your page <head>.\n3. Build and deploy. The links use relative paths, so they work on GitHub Pages project sites.\n\nGenerated locally in your browser. The source logo was not uploaded.\n`;
      }

      async function buildZip() {
        const sizes = new Map();
        for (const size of OUTPUT_SIZES) {
          sizes.set(size, await canvasToBlob(createIconCanvas(size)));
        }

        const icoEntries = [];
        for (const size of [16, 32, 48]) {
          icoEntries.push({ size, bytes: new Uint8Array(await sizes.get(size).arrayBuffer()) });
        }

        const siteName = siteNameInput.value.trim() || 'My Website';
        const zip = new JSZip();
        zip.file('favicon.ico', createIco(icoEntries));
        zip.file('favicon-16x16.png', sizes.get(16));
        zip.file('favicon-32x32.png', sizes.get(32));
        zip.file('apple-touch-icon.png', sizes.get(180));
        zip.file('android-chrome-192x192.png', sizes.get(192));
        zip.file('android-chrome-512x512.png', sizes.get(512));
        zip.file('android-chrome-512x512-maskable.png', sizes.get(512));
        zip.file('site.webmanifest', makeManifest(siteName));
        zip.file('favicon-snippet.html', makeSnippet());
        zip.file('README.txt', makeReadme());
        return zip.generateAsync({ type: 'blob', compression: 'DEFLATE', compressionOptions: { level: 6 } });
      }

      async function downloadPackage() {
        if (!selectedFile || !loadedImage) return;
        downloadButton.disabled = true;
        downloadButton.classList.add('is-loading');
        downloadButton.innerHTML = 'Packaging <span class="spinner" aria-hidden="true"></span>';
        try {
          const zipBlob = await buildZip();
          const url = URL.createObjectURL(zipBlob);
          const anchor = document.createElement('a');
          anchor.href = url;
          anchor.download = 'favicon-package.zip';
          document.body.append(anchor);
          anchor.click();
          anchor.remove();
          URL.revokeObjectURL(url);
          downloadHint.textContent = 'Downloaded · unzip and copy the files into your public folder';
        } catch (error) {
          showError(`Could not create the ZIP file: ${error.message}`);
        } finally {
          downloadButton.disabled = false;
          downloadButton.classList.remove('is-loading');
          downloadButton.innerHTML = 'Download favicon package <span aria-hidden="true">↓</span>';
        }
      }

      dropZone.addEventListener('click', () => fileInput.click());
      dropZone.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          fileInput.click();
        }
      });
      fileInput.addEventListener('change', (event) => handleFile(event.target.files?.[0]));
      changeButton.addEventListener('click', () => fileInput.click());
      downloadButton.addEventListener('click', downloadPackage);

      let previewResizeTimer;
      window.addEventListener('resize', () => {
        if (!loadedImage) return;
        window.clearTimeout(previewResizeTimer);
        previewResizeTimer = window.setTimeout(renderPreviews, 120);
      });

      ['dragenter', 'dragover'].forEach((eventName) => {
        dropZone.addEventListener(eventName, (event) => {
          event.preventDefault();
          dropZone.classList.add('is-dragging');
        });
      });
      ['dragleave', 'drop'].forEach((eventName) => {
        dropZone.addEventListener(eventName, (event) => {
          event.preventDefault();
          dropZone.classList.remove('is-dragging');
        });
      });
      dropZone.addEventListener('drop', (event) => handleFile(event.dataTransfer.files?.[0]));
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #f4f3ee; scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    color: #121416;
    background: #f4f3ee;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(button), :global(input) { font: inherit; }
  :global(button) { cursor: pointer; }
  :global(code) { font-family: "SFMono-Regular", Consolas, monospace; font-size: .88em; }
  .page-shell { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
  .topbar { height: 84px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #d9d8d1; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: #121416; font-size: 14px; font-weight: 750; letter-spacing: -.02em; text-decoration: none; }
  .brand-mark { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 9px; background: #121416; color: #d9ff57; font-size: 14px; font-weight: 800; }
  .privacy-pill { display: inline-flex; align-items: center; gap: 8px; color: #676861; font-size: 12px; }
  .privacy-dot { width: 7px; height: 7px; border-radius: 50%; background: #84a500; box-shadow: 0 0 0 4px rgba(132, 165, 0, .13); }
  .preview-label { color: #7a7b73; font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .result-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
  .drop-zone { min-height: 310px; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-top: 30px; border: 1px dashed #bfc0b5; border-radius: 13px; background: #f7f6f1; text-align: center; transition: border-color .2s, background .2s, transform .2s; }
  .drop-zone:hover, .drop-zone.is-dragging { border-color: #91a91e; background: #f2f7dc; }
  .drop-zone.is-dragging { transform: scale(.995); }
  .drop-icon { width: 48px; height: 48px; display: grid; place-items: center; margin-bottom: 18px; border-radius: 14px; background: #e8edc9; color: #718400; }
  .drop-icon svg { width: 23px; }
  .drop-title { font-size: 17px; font-weight: 700; letter-spacing: -.025em; }
  .drop-subtitle { margin-top: 6px; color: #777970; font-size: 14px; }
  .error-message { margin: 16px 0 0; padding: 12px 14px; border-radius: 8px; background: #fff0ed; color: #a5402a; font-size: 13px; }
  .result-panel { margin-top: 42px; padding-top: 38px; border-top: 1px solid #deddd6; }
  .text-button { padding: 4px 0; border: 0; background: none; color: #788819; font-size: 13px; text-decoration: underline; text-underline-offset: 4px; }
  .preview-layout { display: grid; grid-template-columns: 190px 1fr; gap: 30px; margin-top: 28px; }
  .preview-label { margin-bottom: 12px; font-size: 9px; }
  .source-frame { width: 160px; height: 160px; display: grid; place-items: center; overflow: hidden; border: 1px solid #dfded7; border-radius: 12px; }
  .source-frame img { width: 100%; height: 100%; object-fit: contain; }
  .source-frame img.pixelated {
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
  .checkerboard { background-color: #f8f8f3; background-image: linear-gradient(45deg, #e8e8df 25%, transparent 25%), linear-gradient(-45deg, #e8e8df 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #e8e8df 75%), linear-gradient(-45deg, transparent 75%, #e8e8df 75%); background-size: 14px 14px; background-position: 0 0, 0 7px, 7px -7px, -7px 0; }
  .file-meta { width: 160px; margin-top: 10px; overflow: hidden; color: #8a8b83; font-size: 11px; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
  .preview-grid { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 12px; }
  .preview-card { display: flex; flex-direction: column; align-items: center; gap: 8px; color: #898a82; font-size: 10px; }
  .icon-frame { display: grid; place-items: center; width: 72px; height: 72px; overflow: hidden; border: 1px solid #dfded7; border-radius: 10px; }
  .icon-frame canvas { display: block; image-rendering: auto; }
  .preview-grid.pixel-mode .icon-frame canvas {
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
  .icon-frame.size-16 canvas { width: 16px; height: 16px; }
  .icon-frame.size-32 canvas { width: 32px; height: 32px; }
  .icon-frame.size-48 canvas { width: 48px; height: 48px; }
  .icon-frame.size-180 { width: 192px; height: 192px; }
  .icon-frame.size-180 canvas { width: 180px; height: 180px; }
  .icon-frame.size-192 { width: 204px; height: 204px; }
  .icon-frame.size-192 canvas { width: 192px; height: 192px; }
  .icon-frame.size-512 { width: 268px; height: 268px; }
  .icon-frame.size-512 canvas { width: 256px; height: 256px; }
  .package-settings { display: flex; align-items: center; gap: 18px; margin-top: 32px; padding-top: 24px; border-top: 1px solid #e3e2dc; }
  .package-settings label { flex: 0 0 auto; font-size: 13px; font-weight: 700; }
  .package-settings label span { color: #9b9c94; font-weight: 400; }
  .package-settings input { width: min(300px, 100%); padding: 11px 12px; border: 1px solid #d7d6cf; border-radius: 7px; outline: none; background: #fffefa; color: #121416; font-size: 13px; }
  .package-settings input:focus { border-color: #91a91e; box-shadow: 0 0 0 3px rgba(145, 169, 30, .13); }
  .download-button { display: inline-flex; align-items: center; gap: 18px; padding: 14px 18px; border: 1px solid #121416; border-radius: 8px; background: #121416; color: #f9faee; font-size: 13px; font-weight: 700; transition: background .2s, transform .2s; }
  .download-button:hover { background: #3a3e30; transform: translateY(-1px); }
  .download-button:disabled { cursor: wait; opacity: .7; }
  .download-button > span { color: #d9ff57; font-size: 18px; line-height: 10px; }
  .spinner { width: 13px; height: 13px; border: 2px solid rgba(255,255,255,.25); border-top-color: #d9ff57; border-radius: 50%; animation: spin .7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .download-hint { margin-top: 13px; color: #a0a198; font-size: 11px; text-align: right; }
  @media (max-width: 720px) {
    .page-shell { width: min(100% - 28px, 560px); }
    .topbar { height: 70px; }
    .privacy-pill { font-size: 0; }
    .preview-layout { grid-template-columns: 1fr; gap: 26px; }
    .source-frame, .file-meta { width: 140px; }
    .source-frame { height: 140px; }
    .package-settings { align-items: flex-start; flex-direction: column; gap: 10px; }
    .package-settings input { width: 100%; }
    .download-button { justify-content: center; }
    .download-hint { text-align: left; }
  }

  /* Minimal interface */
  :global(html), :global(body) { background: #fff; }
  .page-shell { width: min(960px, calc(100% - 32px)); }
  .topbar { height: 64px; border-color: #e7e7e3; }
  .brand { font-size: 14px; }
  .brand-mark { width: 26px; height: 26px; border-radius: 7px; }
  .privacy-pill { color: #777; }
  .privacy-dot { width: 6px; height: 6px; box-shadow: none; }
  .intro { padding: 54px 0 28px; }
  .intro h1 { margin: 0; font-size: clamp(36px, 7vw, 58px); line-height: 1; letter-spacing: -.055em; }
  .intro p { margin: 14px 0 0; color: #74746f; font-size: 15px; }
  .workspace { margin-bottom: 48px; padding: 24px; border: 1px solid #e2e2de; border-radius: 14px; }
  .drop-zone { min-height: 180px; flex-direction: row; gap: 16px; margin: 0; border-radius: 10px; background: #fafaf8; }
  .drop-zone[hidden] { display: none; }
  .drop-icon { width: 40px; height: 40px; margin: 0; border-radius: 10px; }
