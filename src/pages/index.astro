---
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#eaf5ff" />
    <meta
      name="description"
      content="Generate a complete favicon package from your logo, directly in your browser."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <title>Favicon Forge — Generate favicons from your logo</title>
  </head>
  <body>
    <main class="page-shell">
      <section class="intro" aria-labelledby="page-title">
        <h1 id="page-title">Generate favicons</h1>
        <p>Drop one logo. Download the complete package.</p>
      </section>

      <section class="workspace" aria-label="Favicon generator">
        <div class="drop-zone" id="drop-zone" role="button" tabindex="0" aria-label="Choose or drop a logo">
          <input id="file-input" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden />
          <div class="drop-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path d="M16 22V5m0 0-6 6m6-6 6 6M7 19v6h18v-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <div class="drop-title" id="drop-title">Drop or choose a logo</div>
            <div class="drop-subtitle" id="drop-subtitle">PNG, JPG, WEBP or SVG · 512×512 or larger recommended</div>
          </div>
        </div>

        <p class="error-message" id="error-message" role="alert" hidden></p>

        <div class="result-panel" id="result-panel" hidden>
          <div class="result-header">
            <h2>Preview</h2>
          </div>

          <div class="preview-layout">
            <div class="source-preview">
              <div class="preview-label">SOURCE LOGO</div>
              <div class="source-frame checkerboard">
                <img class="pixelated" id="source-preview" alt="Selected logo" />
              </div>
              <div class="file-meta" id="file-meta"></div>
            </div>

            <div class="generated-previews">
              <div class="preview-label">OUTPUT SIZES</div>
              <div class="output-surface checkerboard">
                <div class="preview-grid pixel-mode" id="preview-grid"></div>
              </div>
            </div>
          </div>

          <button class="download-button" id="download-button" type="button">
            Download favicon package <span aria-hidden="true">↓</span>
          </button>
        </div>
      </section>
    </main>

    <script>
      // @ts-nocheck — this small client-only module works directly with DOM and Canvas APIs.
      import JSZip from 'jszip';

      const MAX_FILE_SIZE = 10 * 1024 * 1024;
      const OUTPUT_SIZES = [16, 32, 48, 180, 192, 512];
      const PREVIEW_SIZES = [16, 32, 48, 180, 192, 512];
      const PREVIEW_DISPLAY_SIZES = {
        16: 80,
        32: 80,
        48: 80,
        180: 80,
        192: 80,
        512: 80,
      };
      const $ = (selector) => document.querySelector(selector);

      const dropZone = $('#drop-zone');
      const fileInput = $('#file-input');
      const dropTitle = $('#drop-title');
      const dropSubtitle = $('#drop-subtitle');
      const errorMessage = $('#error-message');
      const resultPanel = $('#result-panel');
      const sourcePreview = $('#source-preview');
      const fileMeta = $('#file-meta');
      const previewGrid = $('#preview-grid');
      const downloadButton = $('#download-button');

      let selectedFile = null;
      let loadedImage = null;
      let previewObjectUrl = null;

      function showError(message) {
        errorMessage.textContent = message;
        errorMessage.hidden = false;
      }

      function clearError() {
        errorMessage.hidden = true;
        errorMessage.textContent = '';
      }

      function formatBytes(bytes) {
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
        return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
      }

      function fileNameToSiteName(fileName) {
        const withoutExtension = fileName.replace(/\.[^/.]+$/, '');
        const readable = withoutExtension.replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
        return readable || 'My Website';
      }

      function loadImage(file) {
        return new Promise((resolve, reject) => {
          const objectUrl = URL.createObjectURL(file);
          const image = new Image();
          image.onload = () => {
            URL.revokeObjectURL(objectUrl);
            resolve(image);
          };
          image.onerror = () => {
            URL.revokeObjectURL(objectUrl);
            reject(new Error('This image could not be read. Try another PNG, JPG, WEBP or SVG file.'));
          };
          image.src = objectUrl;
        });
      }

      function createIconCanvas(size) {
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const context = canvas.getContext('2d');
        context.clearRect(0, 0, size, size);
        context.imageSmoothingEnabled = false;

        // Preserve the complete source canvas, including intentional transparent
        // margins. Cropping it changes the pixel grid and makes pixel art uneven.
        const source = loadedImage;
        const sourceWidth = loadedImage.naturalWidth;
        const sourceHeight = loadedImage.naturalHeight;
        const scale = Math.min(size / sourceWidth, size / sourceHeight);
        let width = sourceWidth * scale;
        let height = sourceHeight * scale;
        let x = (size - width) / 2;
        let y = (size - height) / 2;

        width = Math.max(1, Math.round(width));
        height = Math.max(1, Math.round(height));
        x = Math.floor((size - width) / 2);
        y = Math.floor((size - height) / 2);

        context.drawImage(source, x, y, width, height);
        return canvas;
      }

      function canvasToBlob(canvas) {
        return new Promise((resolve, reject) => {
          canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('Could not create a PNG.')), 'image/png');
        });
      }

      function createPreviewImage(size) {
        const outputCanvas = createIconCanvas(size);
        const displaySize = PREVIEW_DISPLAY_SIZES[size];
        const previewCanvas = document.createElement('canvas');
        previewCanvas.width = displaySize;
        previewCanvas.height = displaySize;
        const context = previewCanvas.getContext('2d');
        context.imageSmoothingEnabled = false;
        const previewScale = displaySize / size;
        context.setTransform(previewScale, 0, 0, previewScale, 0, 0);
        context.drawImage(outputCanvas, 0, 0);
        const previewImage = document.createElement('img');
        previewImage.src = previewCanvas.toDataURL('image/png');
        previewImage.width = displaySize;
        previewImage.height = displaySize;
        return previewImage;
      }

      function createIco(entries) {
        const headerSize = 6;
        const directoryEntrySize = 16;
        const dataOffset = headerSize + directoryEntrySize * entries.length;
        const totalSize = dataOffset + entries.reduce((sum, entry) => sum + entry.bytes.length, 0);
        const buffer = new ArrayBuffer(totalSize);
        const view = new DataView(buffer);
        const bytes = new Uint8Array(buffer);

        view.setUint16(0, 0, true);
        view.setUint16(2, 1, true);
        view.setUint16(4, entries.length, true);

        let offset = dataOffset;
        entries.forEach((entry, index) => {
          const directoryOffset = headerSize + index * directoryEntrySize;
          view.setUint8(directoryOffset, entry.size === 256 ? 0 : entry.size);
          view.setUint8(directoryOffset + 1, entry.size === 256 ? 0 : entry.size);
          view.setUint8(directoryOffset + 2, 0);
          view.setUint8(directoryOffset + 3, 0);
          view.setUint16(directoryOffset + 4, 1, true);
          view.setUint16(directoryOffset + 6, 32, true);
          view.setUint32(directoryOffset + 8, entry.bytes.length, true);
          view.setUint32(directoryOffset + 12, offset, true);
          bytes.set(entry.bytes, offset);
          offset += entry.bytes.length;
        });

        return new Blob([buffer], { type: 'image/x-icon' });
      }

      function renderPreviews() {
        previewGrid.replaceChildren();
        PREVIEW_SIZES.forEach((size) => {
          const card = document.createElement('div');
          card.className = 'preview-card';
          const label = document.createElement('span');
          label.textContent = `${size}×${size}`;
          const frame = document.createElement('div');
          frame.className = `icon-frame size-${size}`;
          // Preview the exact generated PNG while keeping every card the same size.
          const image = createPreviewImage(size);
          image.alt = `Preview favicon ${size}x${size}`;
          frame.append(image);
          card.append(frame, label);
          previewGrid.append(card);
        });
      }

      async function handleFile(file) {
        clearError();
        if (!file) return;
        if (!file.type.startsWith('image/')) {
          showError('Please choose an image file.');
          return;
        }
        if (file.size > MAX_FILE_SIZE) {
          showError('That file is too large. Please choose an image smaller than 10 MB.');
          return;
        }

        try {
          selectedFile = file;
          loadedImage = await loadImage(file);
          if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
          previewObjectUrl = URL.createObjectURL(file);
          sourcePreview.src = previewObjectUrl;
          sourcePreview.alt = `Logo ${file.name}`;
          fileMeta.textContent = `${file.name} · ${loadedImage.naturalWidth}×${loadedImage.naturalHeight} · ${formatBytes(file.size)}`;
          renderPreviews();
          resultPanel.hidden = false;
          dropZone.classList.add('has-file');
          dropZone.setAttribute('aria-label', 'Choose or drop another logo');
          dropTitle.textContent = 'Drop or choose another logo';
          dropSubtitle.textContent = 'PNG, JPG, WEBP or SVG · Drop a new file to replace the current logo';
        } catch (error) {
          selectedFile = null;
          loadedImage = null;
          showError(error.message);
        }
      }

      function makeSnippet() {
        return `<!-- Favicon Forge: copy this into your <head> -->
<link rel="icon" href="./favicon-32x32.png" type="image/png" sizes="32x32">
<link rel="icon" href="./favicon-16x16.png" type="image/png" sizes="16x16">
<link rel="icon" href="./favicon.ico" type="image/x-icon">
<link rel="apple-touch-icon" sizes="180x180" href="./apple-touch-icon.png">
<link rel="manifest" href="./site.webmanifest">
<meta name="theme-color" content="#ffffff">`;
      }

      function makeManifest(siteName) {
        return JSON.stringify({
          name: siteName,
          short_name: siteName.slice(0, 20),
          start_url: './',
          scope: './',
          display: 'standalone',
          theme_color: '#ffffff',
          background_color: '#ffffff',
          icons: [
            { src: './android-chrome-192x192.png', sizes: '192x192', type: 'image/png', purpose: 'any' },
            { src: './android-chrome-512x512.png', sizes: '512x512', type: 'image/png', purpose: 'any' },
            { src: './android-chrome-512x512-maskable.png', sizes: '512x512', type: 'image/png', purpose: 'maskable' }
          ]
        }, null, 2);
      }

      function makeReadme() {
        return `FAVICON FORGE\n\nAstro / GitHub Pages\n\n1. Copy these files into your site's public/ folder (or next to index.html).\n2. Copy the contents of favicon-snippet.html into your page <head>.\n3. Build and deploy. The links use relative paths, so they work on GitHub Pages project sites.\n\nGenerated locally in your browser. The source logo was not uploaded.\n`;
      }

      async function buildZip() {
        const sizes = new Map();
        for (const size of OUTPUT_SIZES) {
          sizes.set(size, await canvasToBlob(createIconCanvas(size)));
        }

        const icoEntries = [];
        for (const size of [16, 32, 48]) {
          icoEntries.push({ size, bytes: new Uint8Array(await sizes.get(size).arrayBuffer()) });
        }

        const siteName = fileNameToSiteName(selectedFile?.name || 'My Website');
        const zip = new JSZip();
        zip.file('favicon.ico', createIco(icoEntries));
        zip.file('favicon-16x16.png', sizes.get(16));
        zip.file('favicon-32x32.png', sizes.get(32));
        zip.file('apple-touch-icon.png', sizes.get(180));
        zip.file('android-chrome-192x192.png', sizes.get(192));
        zip.file('android-chrome-512x512.png', sizes.get(512));
        zip.file('android-chrome-512x512-maskable.png', sizes.get(512));
        zip.file('site.webmanifest', makeManifest(siteName));
        zip.file('favicon-snippet.html', makeSnippet());
        zip.file('README.txt', makeReadme());
        return zip.generateAsync({ type: 'blob', compression: 'DEFLATE', compressionOptions: { level: 6 } });
      }

      async function downloadPackage() {
        if (!selectedFile || !loadedImage) return;
        downloadButton.disabled = true;
        downloadButton.classList.add('is-loading');
        downloadButton.innerHTML = 'Packaging <span class="spinner" aria-hidden="true"></span>';
        try {
          const zipBlob = await buildZip();
          const url = URL.createObjectURL(zipBlob);
          const anchor = document.createElement('a');
          anchor.href = url;
          anchor.download = 'favicon-package.zip';
          document.body.append(anchor);
          anchor.click();
          anchor.remove();
          URL.revokeObjectURL(url);
        } catch (error) {
          showError(`Could not create the ZIP file: ${error.message}`);
        } finally {
          downloadButton.disabled = false;
          downloadButton.classList.remove('is-loading');
          downloadButton.innerHTML = 'Download favicon package <span aria-hidden="true">↓</span>';
        }
      }

      dropZone.addEventListener('click', () => fileInput.click());
      dropZone.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          fileInput.click();
        }
      });
      fileInput.addEventListener('change', (event) => handleFile(event.target.files?.[0]));
      downloadButton.addEventListener('click', downloadPackage);

      ['dragenter', 'dragover'].forEach((eventName) => {
        dropZone.addEventListener(eventName, (event) => {
          event.preventDefault();
          dropZone.classList.add('is-dragging');
        });
      });
      ['dragleave', 'drop'].forEach((eventName) => {
        dropZone.addEventListener(eventName, (event) => {
          event.preventDefault();
          dropZone.classList.remove('is-dragging');
        });
      });
      dropZone.addEventListener('drop', (event) => handleFile(event.dataTransfer.files?.[0]));
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) {
    background: #f3f9fe;
    scroll-behavior: smooth;
  }
  :global(body) {
    margin: 0;
    color: #18334d;
    background: #f3f9fe;
    font-family: "Space Grotesk", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(button), :global(input), :global(code) { font: inherit; }
  :global(button) { cursor: pointer; }

  .page-shell {
    width: min(960px, calc(100% - 32px));
    margin: 0 auto;
  }
  .intro {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    padding: 44px 4px 22px;
    animation: soft-reveal .7s cubic-bezier(.22, 1, .36, 1) both;
  }
  .intro h1,
  .intro p {
    margin: 0;
    font-size: 20px;
    line-height: 1.35;
    letter-spacing: -.025em;
  }
  .intro h1 { font-weight: 700; }
  .intro p { color: #6c8297; font-weight: 400; }

  .workspace {
    margin-bottom: 48px;
    padding: 24px;
    border: 1px solid #cfe0ee;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 18px 42px rgba(68, 112, 148, .08);
    animation: soft-reveal .75s .06s cubic-bezier(.22, 1, .36, 1) both;
    transition: border-color .3s ease, box-shadow .3s ease;
  }
  .drop-zone {
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    border: 1px dashed #9fc7e5;
    border-radius: 12px;
    background: #f4faff;
    text-align: center;
    transition: border-color .3s ease, background .3s ease, box-shadow .3s ease, transform .3s cubic-bezier(.22, 1, .36, 1);
  }
  .drop-zone[hidden] { display: none; }
  .drop-zone:hover,
  .drop-zone.is-dragging {
    border-color: #69a8d8;
    background: #e9f5fe;
    box-shadow: 0 10px 24px rgba(72, 135, 181, .1);
  }
  .drop-zone:hover { transform: translateY(-1px); }
  .drop-zone.is-dragging { transform: scale(.995); }
  .drop-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 12px;
    background: #dceefa;
    color: #4b8fbe;
    transition: transform .35s cubic-bezier(.22, 1, .36, 1), background .3s ease;
  }
  .drop-icon svg { width: 21px; }
  .drop-zone:hover .drop-icon { transform: translateY(-2px) rotate(-2deg); }
  .drop-title {
    color: #244b6c;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -.02em;
    text-align: left;
  }
  .drop-subtitle {
    margin-top: 4px;
    color: #7890a4;
    font-size: 12px;
    text-align: left;
  }
  .error-message {
    margin: 16px 0 0;
    padding: 12px 14px;
    border-radius: 9px;
    background: #fff0ed;
    color: #a5402a;
    font-size: 13px;
  }

  .result-panel {
    margin-top: 28px;
    padding: 0;
    animation: result-reveal .55s cubic-bezier(.22, 1, .36, 1) both;
  }
  .result-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .result-header h2 {
    margin: 0;
    color: #18334d;
    font-size: 20px;
    letter-spacing: -.03em;
  }
  .preview-layout {
    display: grid;
    grid-template-columns: 256px minmax(0, 1fr);
    gap: 24px;
    margin-top: 22px;
  }
  .preview-label {
    margin-bottom: 9px;
    color: #69849a;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .source-frame,
  .output-surface {
    overflow: hidden;
    border: 1px solid #cfe0ee;
    border-radius: 12px;
    transition: border-color .3s ease, box-shadow .3s ease;
  }
  .source-frame {
    width: 256px;
    height: 256px;
    display: grid;
    place-items: center;
    animation: soft-reveal .55s .08s cubic-bezier(.22, 1, .36, 1) both;
  }
  .source-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .source-frame img.pixelated,
  .preview-grid.pixel-mode .icon-frame img {
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
  .checkerboard {
    background-color: #f8fcff;
    background-image:
      linear-gradient(45deg, #e5f1f9 25%, transparent 25%),
      linear-gradient(-45deg, #e5f1f9 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #e5f1f9 75%),
      linear-gradient(-45deg, transparent 75%, #e5f1f9 75%);
    background-position: 0 0, 0 7px, 7px -7px, -7px 0;
    background-size: 14px 14px;
  }
  .file-meta {
    width: 256px;
    margin-top: 10px;
    overflow: hidden;
    color: #7890a4;
    font-size: 11px;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .output-surface {
    min-height: 256px;
    padding: 12px;
    animation: soft-reveal .55s .12s cubic-bezier(.22, 1, .36, 1) both;
  }
  .preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .preview-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    padding: 8px 4px 7px;
    border: 1px solid rgba(166, 201, 225, .75);
    border-radius: 10px;
    background: rgba(255, 255, 255, .78);
    color: #59778f;
    font-size: 10px;
    font-weight: 500;
    box-shadow: 0 2px 5px rgba(68, 112, 148, .03);
    animation: preview-reveal .5s cubic-bezier(.22, 1, .36, 1) both;
    transition: border-color .25s ease, box-shadow .25s ease, transform .25s cubic-bezier(.22, 1, .36, 1);
  }
  .preview-card:hover {
    border-color: #9fc7e5;
    box-shadow: 0 8px 18px rgba(68, 112, 148, .1);
    transform: translateY(-2px);
  }
  .preview-card:nth-child(1) { animation-delay: .04s; }
  .preview-card:nth-child(2) { animation-delay: .08s; }
  .preview-card:nth-child(3) { animation-delay: .12s; }
  .preview-card:nth-child(4) { animation-delay: .16s; }
  .preview-card:nth-child(5) { animation-delay: .2s; }
  .preview-card:nth-child(6) { animation-delay: .24s; }
  .icon-frame {
    width: 80px;
    height: 80px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .icon-frame img {
    width: 80px;
    height: 80px;
    display: block;
    object-fit: contain;
  }

  .download-button {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 24px;
    padding: 14px 18px;
    border: 1px solid #679fca;
    border-radius: 10px;
    background: #72add7;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 8px 20px rgba(72, 135, 181, .18);
    transition: background .3s ease, border-color .3s ease, box-shadow .3s ease, transform .3s cubic-bezier(.22, 1, .36, 1);
  }
  .download-button:hover {
    border-color: #4b8fbe;
    background: #5c9dcd;
    transform: translateY(-1px);
  }
  .download-button:disabled { cursor: wait; opacity: .7; }
  .download-button:active { transform: translateY(1px) scale(.995); }
  .download-button > span {
    color: #eff9ff;
    font-size: 18px;
    line-height: 10px;
  }
  .spinner {
    width: 13px;
    height: 13px;
    border: 2px solid rgba(255, 255, 255, .35);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin .7s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes soft-reveal {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes result-reveal {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes preview-reveal {
    from { opacity: 0; transform: translateY(6px) scale(.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(*),
    :global(*::before),
    :global(*::after) {
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
    }
  }

  @media (max-width: 720px) {
    .page-shell { width: calc(100% - 20px); }
    .intro {
      gap: 6px 8px;
      padding: 28px 4px 18px;
    }
    .intro h1,
    .intro p { font-size: 17px; }
